# Copy this file to ".env" (same folder) for local dev. On Vercel, set these in
# Project -> Settings -> Environment Variables instead (never commit real values).

# --- Database (Turso) ---------------------------------------------------------
# Leave both unset locally to use a local SQLite file at server/data/capcare.db.
# Create with:  turso db create capcare
#               turso db show capcare --url            -> TURSO_DATABASE_URL
#               turso db tokens create capcare         -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---------------------------------------------------------------------
# Required in production. Generate with:  openssl rand -hex 32
JWT_SECRET=

# --- News feed (optional) -----------------------------------------------------
# Free key from https://gnews.io/register (100 requests/day). If unset, the app
# falls back to NPR/Google News RSS (no key needed).
GNEWS_API_KEY=
