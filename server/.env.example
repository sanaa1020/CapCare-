# Copy this file to ".env" (same folder) and fill in your key.
# The server auto-loads .env on startup (see index.js); no extra package needed.

# Free key from https://gnews.io/register (100 requests/day). Used as the
# primary source for the general "Health News" feed. If this is left unset,
# the app automatically falls back to NPR/Google News RSS (no key needed).
GNEWS_API_KEY=
